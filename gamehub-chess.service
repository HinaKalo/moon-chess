[Unit]
Description=Moon GameHub Chess
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=gamehub-chess
WorkingDirectory=/opt/chess/current
ExecStart=/opt/pokemon-showdown/runtime/current/bin/node server.cjs
Environment=NODE_ENV=production
Environment=PORT=18887
Environment=BASE_PATH=/gamehub/chess
Environment=PUBLIC_ORIGIN=https://release.moonl.cloud
Environment=DB_PATH=/var/lib/gamehub-chess/rooms.sqlite
Environment=TRUST_PROXY=1
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
